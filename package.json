{
  "devDependencies": {
    "http-server": "^14.1.1",
    "rimraf": "^6.1.3",
    "wasm-pack": "^0.15.0"
  },
  "scripts": {
    "clean": "rimraf dist pkg",
    "dist": "npm run clean && npm run pack && npm run merge",
    "merge": "mkdir dist && cp -r pkg/* static/* dist/",
    "pack": "wasm-pack build --no-pack --no-typescript --release -t web",
    "start": "npm run dist && http-server dist -o"
  }
}